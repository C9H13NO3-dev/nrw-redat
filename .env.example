# Required — Geoapify key (geocoding, autocomplete, amenities, commute)
GEOAPIFY_API_KEY=
# Optional — when set, /api/* requires the X-Api-Key header
REDAT_API_KEY=
# Where redat.db and source/{boris,flood,elections} live (container: /data)
REDAT_DATA_DIR=/data
REDAT_CACHE_TTL_S=21600
# Host of permalinks AND invite links; also switches the session/CSRF cookies to Secure (iff https://).
# Set to your public https URL in production — the LAN http URL below is a local-dev-only default.
REDAT_PUBLIC_URL=http://192.168.188.64:8200
REDAT_LOG_LEVEL=INFO
# First start only: creates the user "admin" with this password when the users table is empty. Change it after login.
REDAT_BOOTSTRAP_ADMIN_PASSWORD=
# Session lifetime in days (sliding); default 30
#REDAT_SESSION_DAYS=30
# Comma-separated CIDRs/IPs whose X-Forwarded-For header is trusted (empty = unset = the built-in
# Docker/RFC1918 default in redat/settings.py). Only matters if the app is reachable other than
# through Traefik — see docker-compose.yml's port binding and HANDOVER "Known limitations".
#REDAT_TRUSTED_PROXIES=
